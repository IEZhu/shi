<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without these two the app records silence rather than failing:
         macOS charges the capture grant to the responsible process and
         reports no error when it is missing. See docs/capture-macos.md. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Transcribes what you say during meetings. Audio stays on this Mac.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Transcribes what other participants say during meetings. Audio stays on this Mac.</string>
</dict>
</plist>
